DATABASE_URL=sqlite+aiosqlite:///./hotel_control_tower.db
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_NAME=Hotel Control Tower
APP_VERSION=1.0.0

# LLM / Copilot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COPILOT_ENABLED=true
COPILOT_MAX_TOKENS=600

# Enterprise Forecasting Platform
# Provider: baseline | timesfm | auto
FORECAST_PROVIDER=baseline
TIMESFM_ENABLED=false
TIMESFM_TIMEOUT_SECONDS=10.0
TIMESFM_MODEL_NAME=google/timesfm-1.0-200m
TIMESFM_CONTEXT_LENGTH=512
TIMESFM_PREDICTION_LENGTH=96
TIMESFM_DEVICE=cpu
FORECAST_EVALUATION_WINDOW=last_30
FORECAST_GOVERNANCE_MAX_JUMP_PP=30.0
FORECAST_GOVERNANCE_MIN_HISTORY_DAYS=14
FORECAST_AUTO_SELECTOR_TTL_SECONDS=3600
